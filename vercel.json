{
  "functions": {
    "api/cron/renew-recurring.js": {
      "maxDuration": 60
    },
    "api/nimble/user-registration.js": {
      "maxDuration": 40
    }
  },
  "crons": [
    {
      "path": "/api/cron/renew-recurring",
      "schedule": "15 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
